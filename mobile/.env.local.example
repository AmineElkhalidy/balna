# Sanity — same dataset as the web app. The mobile app ships these values
# baked in via Expo's `extra` config (see app.config.ts). Copy this file to
# `.env.local` and fill it in for local dev; production values live in EAS
# secrets (`eas secret:create`).
EXPO_PUBLIC_SANITY_PROJECT_ID=enrmb3v3
EXPO_PUBLIC_SANITY_DATASET=production

# WhatsApp — international format, no leading +. Example: 212661234567 for
# a Moroccan number. The mobile app deep-links to whatsapp://send.
EXPO_PUBLIC_MINOR_WHATSAPP=
