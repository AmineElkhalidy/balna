# Environment template for the Minor Shop storefront.
#
# Copy this file to `.env.local` and fill in the real values.
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored — your real keys never end up in the repo.
# When every NEXT_PUBLIC_SANITY_* var is unset the storefront silently falls
# back to the in-memory fixture catalog in `lib/catalog.ts`, so dev still
# works even without a Sanity project.

# ── Sanity (CMS) ────────────────────────────────────────────────────────────
# Find these at https://www.sanity.io/manage → your project → API.
# The "Minor Shop" project ID is committed in the AGENTS.md setup section.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. Only needed if the storefront should read drafts/previews.
# Create at: https://www.sanity.io/manage/project/<id>/api#tokens
# Keep this token server-only — never prefixed with NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Country code + number, digits only. Used as the fallback when the
# `siteSettings` document in Sanity hasn't been filled in yet.
# Example for Morocco: 212600000000
# NEXT_PUBLIC_MINOR_WHATSAPP=

# ── Site origin ─────────────────────────────────────────────────────────────
# Canonical URL used for absolute links (sitemap, OG tags, JSON-LD).
# Defaults to "https://minor-shop.vercel.app" when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
